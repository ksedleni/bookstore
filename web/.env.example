# LCD base used by the browser (default in code: http://127.0.0.1:1317).
# Use /lcd only if you want the Vite dev-server proxy.
VITE_LCD_URL=http://127.0.0.1:1317
# Only used by vite.config.ts when VITE_LCD_URL=/lcd.
VITE_LCD_PROXY_TARGET=http://127.0.0.1:1317
# Optional CometBFT RPC for status display (not used for module queries).
VITE_RPC_URL=http://127.0.0.1:26657
